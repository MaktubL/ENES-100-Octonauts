// Motor safety stop
// This disables the two L298N enable channels.
void stopMotors() {
    analogWrite(MOTOR_ENA_PIN, 0);
    analogWrite(MOTOR_ENB_PIN, 0);
}

// Setup
void setup() {
    Serial.begin(9600);

    // Front ultrasonic sensor.
    pinMode(FRONT_TRIG_PIN, OUTPUT);
    pinMode(FRONT_ECHO_PIN, INPUT);
    digitalWrite(FRONT_TRIG_PIN, LOW);

    // Downward ultrasonic sensor.
    pinMode(DOWN_TRIG_PIN, OUTPUT);
    pinMode(DOWN_ECHO_PIN, INPUT);
    digitalWrite(DOWN_TRIG_PIN, LOW);

    // L298N control pins currently defined in Config.h[cite: 1].
    pinMode(MOTOR_IN3_PIN, OUTPUT);
    pinMode(MOTOR_IN4_PIN, OUTPUT);
    pinMode(MOTOR_ENA_PIN, OUTPUT);
    pinMode(MOTOR_ENB_PIN, OUTPUT);

    // TODO: Initialize GY-31 color sensor pin modes (e.g., COLOR_OUT_PIN as INPUT, COLOR_S3_PIN as OUTPUT).
    
    // TODO: Initialize water pump / relay pin modes (e.g., WATER_PUMP_PIN or PUMP_RELAY_PIN as OUTPUT).

    // TODO: Initialize ENES100 communication protocol.

    // Diagnostic mode: motors remain disabled.
    stopMotors();

    Serial.println();
    Serial.println("========================================");
    Serial.println("OTV Sensor Diagnostic Mode");
    Serial.println("Front obstacle sensor: enabled");
    Serial.println("Downward water measurement: enabled");
    Serial.println("Motors: disabled for safety");
    Serial.println("========================================");
}

// Main loop
// Diagnostic mode only: no autonomous movement is commanded.
void loop() {
    // TODO: Replace this diagnostic loop with a robust state machine structure (e.g., IDLE, NAVIGATING, MEASURING, PUMPING, FINISHED).

    // Keep motors disabled during sensor bring-up.
    stopMotors();

    // Phase 1: Front obstacle measurement
    float frontDistanceMm = 0.0f;
    const bool frontValid = readFrontDistanceMm(frontDistanceMm);

    Serial.print("[Front] ");

    if (!frontValid) {
        Serial.println("No valid measurement.");

        // Do not allow a future motor-control integration to
        // assume the path is clear when the sensor fails.
        stopMotors();
    } else {
        Serial.print("Distance = ");
        Serial.print(frontDistanceMm, 1);
        Serial.println(" mm");

        if (frontDistanceMm < OBSTACLE_STOP_DISTANCE_MM) {
            stopMotors();
            Serial.println("[Front] Obstacle threshold reached.");
            // TODO: Add obstacle avoidance or wait-and-retry behavior here.
        }
    }

    // Separate measurements to reduce ultrasonic crosstalk.
    delay(ULTRASONIC_SENSOR_GAP_MS);

    // Phase 2: Downward distance and estimated water depth
    float waterDistanceMm = 0.0f;
    const bool waterDistanceValid =
        readWaterDistanceMm(waterDistanceMm);

    Serial.print("[Water] ");

    if (!waterDistanceValid) {
        Serial.println(
            "No valid measurement. Check sensor alignment, "
            "water-surface reflection, and wiring."
        );
    } else {
        Serial.print("Distance to water surface = ");
        Serial.print(waterDistanceMm, 1);
        Serial.println(" mm");

        const float waterDepthMm =
            SENSOR_TO_BOTTOM_MM - waterDistanceMm;

        if (waterDepthMm < 0.0f) {
            Serial.println(
                "[Water] Invalid depth: measured distance "
                "exceeds the configured installation height."
            );
        } else {
            Serial.print("[Water] Estimated depth = ");
            Serial.print(waterDepthMm, 1);
            Serial.println(" mm");
            
            // TODO: Record or transmit the measured water depth once the target zone is reached.
        }
    }

    // TODO: Add ENES100 coordinate checking (x, y) to verify arrival at target zones.

    // TODO: Add color sensor reading logic when positioned at target areas.

    Serial.println("----------------------------------------");

    delay(DIAGNOSTIC_INTERVAL_MS);
}