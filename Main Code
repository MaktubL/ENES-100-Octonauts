#include <Arduino.h>
#include "Config.h"

// Approximate usable HC-SR04 measurement range.
// Verify these limits against your actual sensors and setup.
constexpr float MIN_VALID_DISTANCE_MM = 20.0f;
constexpr float MAX_VALID_DISTANCE_MM = 4000.0f;

// Leave time between two ultrasonic measurements to reduce
// the risk of one sensor detecting the other's echo.
constexpr unsigned long ULTRASONIC_SENSOR_GAP_MS = 60;

// Diagnostic output interval.
constexpr unsigned long DIAGNOSTIC_INTERVAL_MS = 500;

// Ensure the installation height is configured correctly.
static_assert(SENSOR_TO_BOTTOM_MM > 0.0f,
              "SENSOR_TO_BOTTOM_MM must be greater than zero.");

// TODO: Integrate ENES100 library and Wi-Fi client initialization to fetch real-time (x, y, theta) positioning data.

// Shared ultrasonic measurement function
// Returns false if the measurement is missing or invalid.
bool readDistanceMm(int trigPin, int echoPin, float &distanceMm) {
    // Send a short trigger pulse.
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);

    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);

    // Measure the echo pulse duration.
    const unsigned long duration =
        pulseIn(echoPin, HIGH, ECHO_TIMEOUT_US);

    // A duration of zero means no echo arrived before timeout.
    if (duration == 0) {
        return false;
    }

    // Convert round-trip travel time into one-way distance.
    const float measuredDistanceMm =
        duration * SOUND_SPEED_MM_PER_US / 2.0f;

    // Reject measurements outside the configured usable range.
    if (measuredDistanceMm < MIN_VALID_DISTANCE_MM ||
        measuredDistanceMm > MAX_VALID_DISTANCE_MM) {
        return false;
    }

    distanceMm = measuredDistanceMm;
    return true;
}

// Front ultrasonic sensor
bool readFrontDistanceMm(float &distanceMm) {
    return readDistanceMm(
        FRONT_TRIG_PIN,
        FRONT_ECHO_PIN,
        distanceMm
    );
}

// Downward ultrasonic sensor
bool readWaterDistanceMm(float &distanceMm) {
    return readDistanceMm(
        DOWN_TRIG_PIN,
        DOWN_ECHO_PIN,
        distanceMm
    );
}

