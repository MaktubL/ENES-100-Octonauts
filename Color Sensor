const int S0 = 7;
const int S1 = 8;
const int S2 = 11;
const int S3 = 12;
const int sensorOut = 2;
const int LED = 4;

const int redThreshold = 780;
const int samples = 7;

unsigned long readColor(bool s2, bool s3) {
  digitalWrite(S2, s2);
  digitalWrite(S3, s3);

  delay(50);

  return pulseIn(sensorOut, LOW, 100000);
}

void setup() {
  pinMode(S0, OUTPUT);
  pinMode(S1, OUTPUT);
  pinMode(S2, OUTPUT);
  pinMode(S3, OUTPUT);
  pinMode(sensorOut, INPUT);
  pinMode(LED, OUTPUT);

  digitalWrite(S0, HIGH);
  digitalWrite(S1, LOW);
  digitalWrite(LED, HIGH);

  Serial.begin(9600);
}

void loop() {
  unsigned long totalRed = 0;
  int validReadings = 0;

  for (int i = 0; i < samples; i++) {
    unsigned long red = readColor(LOW, LOW);

    if (red > 0) {
      totalRed += red;
      validReadings++;
    }

    delay(100);
  }

  if (validReadings == 0) {
    Serial.println("ERROR: No valid readings");
  }
  else {
    float averageRed = (float)totalRed / validReadings;

    Serial.print("Average red: ");
    Serial.print(averageRed, 2);

    if (averageRed < redThreshold) {
      Serial.println(" | POLLUTED");
    }
    else {
      Serial.println(" | CLEAN");
    }
  }

  delay(500);
}
