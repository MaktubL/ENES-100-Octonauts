import math

# Simulator-only candidate. Pose is supplied by ArUco; one FRONT range sensor.
# White vertical bar is the right-hand approach target, not arena centre.
GOAL = (3.15, 1.45)
# Restored sensor-only version: rumble strips remain traversable.
BODY_RADIUS = 0.097
CLEARANCE = 0.10
MARGIN = BODY_RADIUS + CLEARANCE + 0.04
CELL = 0.05
state = 'SCAN'
hits = set()
blocked = set()
waypoint = GOAL
done = False
route = []
route_i = 0
scan_last = 0.0
scan_swept = 0.0
scan_x = 0.0
scan_y = 0.0
SCAN_PWM = 35  # Nominal full sweep ~23 s with this simulator's motor model.
CRUISE_PWM = 90
FRONT_STOP = 0.40
scan_count = 0
last_obstacle_scan = (-10.0, -10.0)

def wrap(a):
    return math.atan2(math.sin(a), math.cos(a))

def stop():
    tank.turn_off_motors()

def motors(l, r):
    tank.set_left_motor_pwm(int(l))
    tank.set_right_motor_pwm(int(r))

def turn(target, theta):
    e = wrap(target - theta)
    if abs(e) < 0.012:
        stop()
        return True
    v = min(90, max(8, abs(e) * 110))
    s = 1 if e > 0 else -1
    motors(-s * v, s * v)
    return False

def start_scan(theta):
    global state, scan_last, scan_swept, scan_x, scan_y, scan_count
    stop()
    state, scan_last, scan_swept = 'SCAN', theta, 0.0
    scan_x, scan_y = enes100.get_x(), enes100.get_y()
    scan_count += 1
    enes100.println('360 scan #%d: x=%.2f y=%.2f' % (scan_count, scan_x, scan_y))

def record_hit(x, y, theta, d):
    if 0 <= d < 1.0:
        r = d + 0.075
        hits.add((int(round((x + r * math.cos(theta)) / 0.025)),
                  int(round((y + r * math.sin(theta)) / 0.025))))

def corners(path):
    # Keep every corner, merge consecutive collinear grid edges only.
    # Unlike arbitrary shortcutting, this preserves the checked grid route.
    result = []
    for i in range(1, len(path)):
        if i == len(path) - 1 or (path[i][0] - path[i-1][0], path[i][1] - path[i-1][1]) != (path[i+1][0] - path[i][0], path[i+1][1] - path[i][1]):
            result.append((path[i][0] * CELL, path[i][1] * CELL))
    return result

def node(x, y):
    return (int(round(x / CELL)), int(round(y / CELL)))

def safe(n):
    x, y = n[0] * CELL, n[1] * CELL
    return MARGIN <= x <= 4 - MARGIN and MARGIN <= y <= 2 - MARGIN and n not in blocked

def plan(x, y):
    global blocked
    blocked = set()
    for hx, hy in hits:
        hx, hy = hx * 0.025, hy * 0.025
        i, j = node(hx, hy)
        for di in range(-5, 6):
            for dj in range(-5, 6):
                if ((i + di) * CELL - hx) ** 2 + ((j + dj) * CELL - hy) ** 2 <= MARGIN ** 2:
                    blocked.add((i + di, j + dj))
    start, end = node(x, y), node(GOAL[0], GOAL[1])
    if not safe(start) or not safe(end):
        return []
    opened, costs, parent, closed = [start], {start: 0}, {}, set()
    while opened:
        cur = min(opened, key=lambda n: costs[n] + abs(n[0] - end[0]) + abs(n[1] - end[1]))
        opened.remove(cur)
        if cur == end:
            path = [cur]
            while cur != start:
                cur = parent[cur]
                path.append(cur)
            path.reverse()
            return path
        closed.add(cur)
        for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nxt = (cur[0] + di, cur[1] + dj)
            if nxt in closed or not safe(nxt):
                continue
            c = costs[cur] + 1
            if c < costs.get(nxt, 100000):
                costs[nxt], parent[nxt] = c, cur
                if nxt not in opened:
                    opened.append(nxt)
    return []

def setup():
    global hits, done, route, route_i, scan_count, last_obstacle_scan
    tank.begin()
    enes100.begin('Scan Navigation', WATER, 0)
    hits, done = set(), False
    route, route_i = [], 0
    scan_count, last_obstacle_scan = 0, (-10.0, -10.0)
    start_scan(enes100.get_theta())
    enes100.println('Collecting 360-degree scan before navigation')

def loop():
    global state, waypoint, done, route, route_i, scan_last, scan_swept, last_obstacle_scan
    if done or not enes100.is_visible():
        stop()
        return
    x, y, theta = enes100.get_x(), enes100.get_y(), enes100.get_theta()
    if math.sqrt((GOAL[0] - x) ** 2 + (GOAL[1] - y) ** 2) < 0.04:
        stop()
        done = True
        enes100.println('RIGHT BAR APPROACH REACHED')
        return
    if state == 'SCAN':
        delta = wrap(theta - scan_last)
        scan_last = theta
        # Reject a teleport/large heading jump instead of claiming a full scan.
        if abs(delta) > 0.15 or math.sqrt((x-scan_x)**2 + (y-scan_y)**2) > 0.025:
            stop()
            done = True
            enes100.println('STOP: pose changed during scan; reset and run again')
            return
        scan_swept += delta
        record_hit(x, y, theta, tank.read_distance_sensor(1))
        if scan_swept >= 2 * math.pi:
            stop()
            state = 'PLAN'
            enes100.println('Scan complete; planning continuous route')
        else:
            motors(-SCAN_PWM, SCAN_PWM)
    elif state == 'PLAN':
        path = plan(x, y)
        if len(path) < 2:
            stop()
            done = True
            enes100.println('STOP: no mapped route with required clearance')
            return
        route, route_i = corners(path), 0
        waypoint = route[route_i]
        state = 'MOVE'
    elif state == 'MOVE':
        dx, dy = waypoint[0] - x, waypoint[1] - y
        dist = math.sqrt(dx * dx + dy * dy)
        if dist < 0.015:
            route_i += 1
            if route_i < len(route):
                waypoint = route[route_i]
            else:
                stop()
                state = 'PLAN'
            return
        target = math.atan2(dy, dx)
        error = wrap(target - theta)
        if abs(error) > 0.06:
            turn(target, theta)
            return
        d = tank.read_distance_sensor(1)
        unknown = False
        if 0 <= d < FRONT_STOP:
            hx = x + (d + 0.075) * math.cos(theta)
            hy = y + (d + 0.075) * math.sin(theta)
            unknown = not any((px*0.025-hx)**2 + (py*0.025-hy)**2 < 0.08**2 for px, py in hits)
        if d != -1 and (d < 0.14 or (d < FRONT_STOP and unknown)):
            stop()
            record_hit(x, y, theta, d)
            # Scan when a new obstruction is encountered, not at waypoints.
            # Suppress repeated full rotations at the same location.
            moved = math.sqrt((x-last_obstacle_scan[0])**2 + (y-last_obstacle_scan[1])**2)
            if moved > 0.25:
                last_obstacle_scan = (x, y)
                start_scan(theta)
            else:
                state = 'PLAN'
                enes100.println('Same obstruction: retain scan and replan')
            return
        speed = min(CRUISE_PWM, max(14, dist * 500))
        correction = max(-20, min(20, int(error * 200)))
        motors(speed - correction, speed + correction)
