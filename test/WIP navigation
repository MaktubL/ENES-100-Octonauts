#include <Arduino.h>
#include <Enes100.h>
#include <math.h>

#if !defined(__AVR_ATmega328P__)
#error "Select Arduino Uno (Uno R3 / ATmega328P)."
#endif

// WiFi 模块 TX 接 Uno D8，模块 RX 接 Uno D9。
// 如果实际接线相反，交换这两个值。
const byte WIFI_MODULE_TX = 8;
const byte WIFI_MODULE_RX = 9;

const int MARKER_ID = 106;
const int ROOM_NUMBER = 1116;

// 建议 H-Bridge 接线，必须与实际接线一致。
const byte LEFT_IN1 = 3;
const byte LEFT_IN2 = 4;
const byte LEFT_ENABLE = 5;

const byte RIGHT_IN1 = 7;
const byte RIGHT_IN2 = 11;
const byte RIGHT_ENABLE = 6;

// 某一侧电机方向相反时，将对应值改成 -1。
const int LEFT_SIGN = 1;
const int RIGHT_SIGN = 1;

const byte FRONT_TRIG = A1;
const byte FRONT_ECHO = A2;

const int DRIVE_PWM = 145;
const int TURN_PWM = 125;

// false 表示发送 1 后开始移动。
// true 表示在 A/B 稳定定位 5 秒后自动开始导航 1。
const bool AUTO_START_NAV1 = false;

// 长度单位为米，角度单位为弧度。
// 以下安装参数需要按实际车辆测量。
const float BODY_LENGTH = 0.252f;
const float BODY_WIDTH = 0.248f;
const float ARM_EXTENSION = 0.106f;

// 前向超声波声学面相对车身中心的位置。
const float SENSOR_FORWARD = 0.232f;
const float SENSOR_LEFT = 0.0f;

// 从 Marker 中心到车身中心的局部坐标偏移。
// 后置 Marker 的这两个值需要实测。
const float MARKER_TO_CENTER_FORWARD = 0.0f;
const float MARKER_TO_CENTER_LEFT = 0.0f;

// 车头朝向 = Marker 报告角度 + 这个修正值。
const float MARKER_TO_FORWARD_ANGLE = 0.0f;

// 车头最前端到任务参考点的目标距离。
const float MISSION_STANDOFF = 0.10f;

// 初始规划安全余量，需要实车验证。
const float CLEARANCE = 0.05f;

// 正常行驶时，超声波小于此距离则停车。
const float TRANSIT_STOP = 0.18f;

const float POSITION_TOLERANCE = 0.03f;
const float ANGLE_TOLERANCE = 0.07f;
const float PI_VALUE = 3.141592654f;

struct Point {
  float x, y;
};

struct Pose {
  float x, y, angle;
  bool valid;
};

enum State : byte {
  READY,
  APPROACH,
  FACE_MISSION,
  WAIT_MISSION,
  BACK_TO_GAP,
  GO_STAGING,
  SCAN,
  PLAN,
  FOLLOW,
  ENTER_GOAL,
  FINISHED,
  FAULT
};

enum MoveResult : byte {
  ARRIVED,
  MOVING,
  BLOCKED,
  NO_RANGE
};

// 使用小型栅格，适应 Uno R3 的内存。
// 格子边长 0.2 m，障碍物按车身包络膨胀。
class Map {
public:
  static const byte GRID_COLUMNS = 20;
  static const byte GRID_ROWS = 10;
  static const byte GRID_CELLS = 200;

  byte occupied[25] = {};
  byte parent[GRID_CELLS];

  // 规划时作为 BFS 队列，规划结束后保存路线。
  byte route[GRID_CELLS];
  byte length = 0;

  static Point center(byte index) {
    return {
      (index % GRID_COLUMNS + 0.5f) * 0.2f,
      (index / GRID_COLUMNS + 0.5f) * 0.2f
    };
  }

  static int index(Point point) {
    if (point.x < 0 || point.x >= 4 ||
        point.y < 0 || point.y >= 2) {
      return -1;
    }

    return int(point.y / 0.2f) * GRID_COLUMNS
         + int(point.x / 0.2f);
  }

  bool hit(byte index) const {
    return occupied[index / 8]
         & (1 << (index % 8));
  }

  void clear() {
    memset(occupied, 0, sizeof(occupied));
    length = 0;
  }

  void addRay(Pose pose, float range) {
    const float cosine = cosf(pose.angle);
    const float sine = sinf(pose.angle);

    Point endpoint = {
      pose.x
        + SENSOR_FORWARD * cosine
        - SENSOR_LEFT * sine
        + range * cosine,

      pose.y
        + SENSOR_FORWARD * sine
        + SENSOR_LEFT * cosine
        + range * sine
    };

    // 已知场地墙壁由边界检查处理。
    if (endpoint.x < 0.03f ||
        endpoint.x > 3.97f ||
        endpoint.y < 0.03f ||
        endpoint.y > 1.97f) {
      return;
    }

    int cell = index(endpoint);

    if (cell >= 0) {
      occupied[cell / 8] |= 1 << (cell % 8);
    }
  }

  bool blocked(Point point) const {
    float radius =
      hypotf(
        BODY_LENGTH / 2 + ARM_EXTENSION,
        BODY_WIDTH / 2
      ) + CLEARANCE;

    if (point.x < radius ||
        point.x > 4 - radius ||
        point.y < radius ||
        point.y > 2 - radius) {
      return true;
    }

    // 最后一道分界的下半部分禁止通过。
    if (fabsf(point.x - 3.4f) <= radius + 0.025f &&
        point.y <= 1 + radius) {
      return true;
    }

    // 任务区半边长暂按 0.20 m。
    for (byte site = 0; site < 2; ++site) {
      float y = site ? 1.5f : 0.5f;

      float dx = fmaxf(
        fabsf(point.x - 0.5f) - 0.20f,
        0
      );

      float dy = fmaxf(
        fabsf(point.y - y) - 0.20f,
        0
      );

      if (hypotf(dx, dy) < radius) {
        return true;
      }
    }

    for (int cell = 0; cell < GRID_CELLS; ++cell) {
      if (!hit(cell)) {
        continue;
      }

      Point obstacle = center(cell);

      if (hypotf(
            point.x - obstacle.x,
            point.y - obstacle.y
          ) < radius + 0.142f) {
        return true;
      }
    }

    return false;
  }

  bool plan(Point from, Point goal) {
    int start = index(from);
    int finish = index(goal);

    length = 0;

    if (start < 0 ||
        finish < 0 ||
        blocked(from) ||
        blocked(center(start)) ||
        blocked(center(finish))) {
      return false;
    }

    memset(parent, 255, sizeof(parent));
    parent[start] = start;

    int head = 0;
    int tail = 0;

    route[tail++] = start;

    while (head < tail) {
      byte current = route[head++];

      if (current == finish) {
        byte cursor = finish;

        while (true) {
          if (length >= GRID_CELLS) {
            return false;
          }

          route[length++] = cursor;

          if (cursor == start) {
            break;
          }

          cursor = parent[cursor];
        }

        for (int a = 0, b = length - 1;
             a < b;
             ++a, --b) {
          byte temporary = route[a];
          route[a] = route[b];
          route[b] = temporary;
        }

        return true;
      }

      for (byte direction = 0;
           direction < 4;
           ++direction) {
        int x = current % GRID_COLUMNS;
        int y = current / GRID_COLUMNS;

        if (direction == 0) {
          ++x;
        }

        if (direction == 1) {
          --x;
        }

        if (direction == 2) {
          ++y;
        }

        if (direction == 3) {
          --y;
        }

        if (x < 0 ||
            x >= GRID_COLUMNS ||
            y < 0 ||
            y >= GRID_ROWS) {
          continue;
        }

        int next = y * GRID_COLUMNS + x;

        if (parent[next] != 255 ||
            blocked(center(next))) {
          continue;
        }

        Point a = center(current);
        Point b = center(next);

        if (blocked({
              (a.x + b.x) / 2,
              (a.y + b.y) / 2
            })) {
          continue;
        }

        parent[next] = current;

        if (tail >= GRID_CELLS) {
          return false;
        }

        route[tail++] = next;
      }
    }

    return false;
  }
};

Map arena;

Pose pose = {0, 0, 0, false};
Pose progress = {0, 0, 0, false};

Point mission = {0.5f, 1.5f};
Point missionStop = {0.5f, 1.0f};

State state = READY;

const __FlashStringHelper *message = nullptr;
const __FlashStringHelper *poseMessage = nullptr;

float frontRange = NAN;
float scanOrigin = 0;
float samples[3];

bool frontValid = false;
bool running = false;
bool autoAllowed = AUTO_START_NAV1;

byte networkState = 255;
byte scanStep = 0;
byte sampleCount = 0;
byte routeStep = 0;

unsigned int motorTimeWithoutProgress = 0;

unsigned long phaseAt = 0;
unsigned long poseAt = 0;
unsigned long lastCycle = 0;
unsigned long lastPrint = 0;
unsigned long settledAt = 0;
unsigned long rangeAt = 0;
unsigned long lastSampleAt = 0;
unsigned long stableSince = 0;

bool settled = false;

// 显式函数声明，避免 Arduino 自动生成声明时的类型问题。
float wrapAngle(float angle);
float separation(Point a, Point b);
char startZone();

void stopMotors();
void setSide(byte in1, byte in2, byte enable, int pwm);
void pulseMotors(int left, int right, unsigned int duration);

bool turnTo(float angle);

MoveResult driveTo(
  Point target,
  float stopDistance,
  bool reverse = false
);

void changeState(State next);
void fail(const __FlashStringHelper *reason);
void beginScan();

bool readPose();
void readRange();

void startMission();
