void setup();
void loop();

float wrapAngle(float angle) {
  while (angle > PI_VALUE) {
    angle -= 2 * PI_VALUE;
  }

  while (angle < -PI_VALUE) {
    angle += 2 * PI_VALUE;
  }

  return angle;
}

float separation(Point a, Point b) {
  return hypotf(a.x - b.x, a.y - b.y);
}

char startZone() {
  if (!pose.valid ||
      pose.x < 0 ||
      pose.x > 0.8f ||
      pose.y < 0 ||
      pose.y > 2) {
    return '?';
  }

  if (pose.y <= 0.85f) {
    return 'B';
  }

  if (pose.y >= 1.15f) {
    return 'A';
  }

  return '?';
}

void stopMotors() {
  analogWrite(LEFT_ENABLE, 0);
  analogWrite(RIGHT_ENABLE, 0);

  digitalWrite(LEFT_IN1, LOW);
  digitalWrite(LEFT_IN2, LOW);

  digitalWrite(RIGHT_IN1, LOW);
  digitalWrite(RIGHT_IN2, LOW);
}

void setSide(
  byte in1,
  byte in2,
  byte enable,
  int pwm
) {
  analogWrite(enable, 0);

  digitalWrite(
    in1,
    pwm > 0 ? HIGH : LOW
  );

  digitalWrite(
    in2,
    pwm < 0 ? HIGH : LOW
  );

  analogWrite(
    enable,
    constrain(abs(pwm), 0, 255)
  );
}

void pulseMotors(
  int left,
  int right,
  unsigned int duration
) {
  setSide(
    LEFT_IN1,
    LEFT_IN2,
    LEFT_ENABLE,
    left * LEFT_SIGN
  );

  setSide(
    RIGHT_IN1,
    RIGHT_IN2,
    RIGHT_ENABLE,
    right * RIGHT_SIGN
  );

  unsigned long started = millis();

  while (millis() - started < duration) {
    if (Serial.available() &&
        (Serial.peek() == 'x' ||
         Serial.peek() == 'X')) {
      Serial.read();
      stopMotors();

      running = false;
      autoAllowed = false;
      state = READY;
      message = F("Stopped by x");

      return;
    }

    delay(1);
  }

  stopMotors();
  motorTimeWithoutProgress += duration;
}

bool turnTo(float angle) {
  float error = wrapAngle(
    angle - pose.angle
  );

  if (fabsf(error) <= ANGLE_TOLERANCE) {
    return true;
  }

  unsigned int duration =
    fabsf(error) < 0.20f ? 25 : 50;

  if (error > 0) {
    pulseMotors(
      -TURN_PWM,
      TURN_PWM,
      duration
    );
  }
  else {
    pulseMotors(
      TURN_PWM,
      -TURN_PWM,
      duration
    );
  }

  return false;
}

MoveResult driveTo(
  Point target,
  float stopDistance,
  bool reverse
) {
  float distance = separation(
    {pose.x, pose.y},
    target
  );

  if (distance <= POSITION_TOLERANCE) {
    return ARRIVED;
  }

  float angle = atan2f(
    target.y - pose.y,
    target.x - pose.x
  );

  if (reverse) {
    angle = wrapAngle(
      angle + PI_VALUE
    );
  }

  if (!turnTo(angle)) {
    return MOVING;
  }

  if (!reverse && !frontValid) {
    message = F("Waiting for valid front echo");
    return NO_RANGE;
  }

  if (!reverse && frontRange < stopDistance) {
    message = F("Front obstacle: stopped");
    return BLOCKED;
  }

  int pwm = reverse
    ? -DRIVE_PWM
    : DRIVE_PWM;

  pulseMotors(
    pwm,
    pwm,
    distance < 0.12f ? 30 : 60
  );

  return MOVING;
}

void changeState(State next) {
  state = next;
  phaseAt = millis();
}

void fail(const __FlashStringHelper *reason) {
  stopMotors();

  running = false;
  autoAllowed = false;
  state = FAULT;
  message = reason;
}

void beginScan() {
  scanOrigin = pose.angle;
  scanStep = 0;
  sampleCount = 0;
  settled = false;

  changeState(SCAN);

  message = F("Scanning 360 degrees");
}

bool readPose() {
  stopMotors();
  pose.valid = false;

  networkState = Enes100.state();

  if (networkState != 1) {
    poseMessage = F("WIFI/VISION DISCONNECTED");
    return false;
  }

  // 针对官方 ENES100 v6.2.4 的公开位置缓存。
  Enes100.location.x = -1;
  Enes100.location.y = -1;
  Enes100.location.theta = NAN;

  unsigned long started = millis();

  bool visible = Enes100.isVisible();

  float x = Enes100.location.x;
  float y = Enes100.location.y;
  float angle = Enes100.location.theta;

  if (!visible) {
    poseMessage = F("MARKER 106 NOT VISIBLE");
    return false;
  }

  if (millis() - started >= 100UL ||
      !isfinite(x) ||
      !isfinite(y) ||
      !isfinite(angle) ||
      x < 0 ||
      x > 4 ||
      y < 0 ||
      y > 2 ||
      fabsf(angle) > 3.20f) {
    poseMessage = F("NO COMPLETE NEW POSE");
    return false;
  }

  angle = wrapAngle(
    angle + MARKER_TO_FORWARD_ANGLE
  );

  pose = {
    x
      + MARKER_TO_CENTER_FORWARD * cosf(angle)
      - MARKER_TO_CENTER_LEFT * sinf(angle),

    y
      + MARKER_TO_CENTER_FORWARD * sinf(angle)
      + MARKER_TO_CENTER_LEFT * cosf(angle),

    angle,
    true
  };

  if (pose.x < 0 ||
      pose.x > 4 ||
      pose.y < 0 ||
      pose.y > 2) {
    pose.valid = false;
    poseMessage = F("BODY CENTER OUTSIDE FIELD");
    return false;
  }

  poseAt = millis();
  poseMessage = F("OK");

  return true;
}

void readRange() {
  frontValid = false;

  digitalWrite(FRONT_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(FRONT_TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(FRONT_TRIG, LOW);

  unsigned long echo = pulseIn(
    FRONT_ECHO,
    HIGH,
    25000UL
  );

  rangeAt = millis();

  if (!echo) {
    return;
  }

  frontRange =
    echo * 0.000343f / 2;

  frontValid =
    frontRange >= 0.02f &&
    frontRange <= 4.0f;
}

void startMission() {
  if (!pose.valid ||
      startZone() == '?') {
    message = F("Need valid A/B pose");
    return;
  }

  bool fromA =
    startZone() == 'A';

  mission = {
    0.5f,
    fromA ? 0.5f : 1.5f
  };

  float offset =
    BODY_LENGTH / 2
    + ARM_EXTENSION
    + MISSION_STANDOFF;

  missionStop = {
    mission.x,
    mission.y + (fromA ? offset : -offset)
  };

  running = true;
  autoAllowed = false;
  motorTimeWithoutProgress = 0;

  progress = pose;

  arena.clear();
  changeState(APPROACH);

  message = F("Nav1: approaching opposite mission site");
}

void startDestination() {
  if (!pose.valid) {
    message = F("Need valid pose");
    return;
  }

  running = true;
  autoAllowed = false;
  motorTimeWithoutProgress = 0;

  progress = pose;

  arena.clear();

  if (pose.x < 0.8f) {
    changeState(GO_STAGING);
    message = F("Moving to scan staging point");
  }
  else {
    beginScan();
  }
}

bool insideDestination() {
  const float frontExtent =
    BODY_LENGTH / 2 + ARM_EXTENSION;

  for (byte corner = 0;
       corner < 4;
       ++corner) {
    float forward = corner < 2
      ? frontExtent
      : -BODY_LENGTH / 2;

    float left = corner % 2
      ? BODY_WIDTH / 2
      : -BODY_WIDTH / 2;

    float x =
      pose.x
      + forward * cosf(pose.angle)
      - left * sinf(pose.angle);

    float y =
      pose.y
      + forward * sinf(pose.angle)
      + left * cosf(pose.angle);

    if (x < 3.4f ||
        x > 4.0f ||
        y < 0.0f ||
        y > 2.0f) {
      return false;
    }
  }

  return true;
}

void navigation() {
  if (!running ||
      !pose.valid ||
      millis() - poseAt > 200UL) {
    return;
  }

  bool positionChanged =
    separation(
      {pose.x, pose.y},
      {progress.x, progress.y}
    ) > 0.012f;

  bool angleChanged =
    fabsf(
      wrapAngle(
        pose.angle - progress.angle
      )
    ) > 0.04f;

  if (!progress.valid ||
      positionChanged ||
      angleChanged) {
    progress = pose;
    motorTimeWithoutProgress = 0;
  }

  if (motorTimeWithoutProgress > 600) {
    fail(
      F("No movement feedback: check PWM/direction")
    );
    return;
  }

  if (state != WAIT_MISSION &&
      millis() - phaseAt > 120000UL) {
    fail(F("Stage timeout"));
    return;
  }

  switch (state) {
  case APPROACH:
    if (driveTo(
          missionStop,
          0.07f
        ) == ARRIVED) {
      changeState(FACE_MISSION);
    }
    break;

  case FACE_MISSION:
    if (turnTo(
          atan2f(
            mission.y - pose.y,
            mission.x - pose.x
          )
        )) {
      Point tip = {
        pose.x
          + (BODY_LENGTH / 2 + ARM_EXTENSION)
          * cosf(pose.angle),

        pose.y
          + (BODY_LENGTH / 2 + ARM_EXTENSION)
          * sinf(pose.angle)
      };

      if (separation(tip, mission) > 0.15f) {
        fail(
          F("Check mission reference/geometry")
        );
        break;
      }

      changeState(WAIT_MISSION);

      message =
        F("Nav1 reached. Complete mission; send m");
    }
    break;

  case WAIT_MISSION:
    break;

  case BACK_TO_GAP:
    // 沿刚刚接近任务点的通道退回。
    // 实车必须确认后方通道保持畅通。
    if (driveTo(
          {0.5f, 1.0f},
          0,
          true
        ) == ARRIVED) {
      changeState(GO_STAGING);
    }
    break;

  case GO_STAGING:
    if (driveTo(
          {1.1f, 1.0f},
          TRANSIT_STOP
        ) == ARRIVED) {
      beginScan();
    }
    break;

  case SCAN: {
    float targetAngle = wrapAngle(
      scanOrigin
      + scanStep * PI_VALUE / 9
    );

    if (!turnTo(targetAngle)) {
      settled = false;
      sampleCount = 0;
      break;
    }

    if (scanStep == 18) {
      changeState(PLAN);
      break;
    }

    if (!settled) {
      settled = true;
      settledAt = millis();
      sampleCount = 0;
      break;
    }

    // 无回波保持未知，等待一秒后跳过该方向。
    if (!frontValid &&
        millis() - settledAt > 1000UL) {
      ++scanStep;
      settled = false;
      break;
    }

    if (!frontValid ||
        millis() - settledAt < 150UL ||
        rangeAt == lastSampleAt) {
      break;
    }

    lastSampleAt = rangeAt;
    samples[sampleCount++] = frontRange;

    if (sampleCount == 3) {
      for (byte a = 0; a < 2; ++a) {
        for (byte b = a + 1; b < 3; ++b) {
          if (samples[a] > samples[b]) {
            float temporary = samples[a];
            samples[a] = samples[b];
            samples[b] = temporary;
          }
        }
      }

      arena.addRay(
        pose,
        samples[1]
      );

      ++scanStep;
      settled = false;
      sampleCount = 0;
    }
    break;
  }

  case PLAN:
    if (!arena.plan(
          {pose.x, pose.y},
          {3.5f, 1.5f}
        )) {
      fail(
        F("No route with measured map/clearance")
      );
      break;
    }

    routeStep = 0;

    changeState(FOLLOW);

    message =
      F("Following route toward upper gate");
    break;

  case FOLLOW: {
    if (routeStep >= arena.length) {
      changeState(ENTER_GOAL);
      break;
    }

    MoveResult result = driveTo(
      Map::center(
        arena.route[routeStep]
      ),
      TRANSIT_STOP
    );

    if (result == ARRIVED) {
      ++routeStep;
      phaseAt = millis();
    }

    if (result == BLOCKED) {
      arena.addRay(
        pose,
        frontRange
      );

      beginScan();
    }
    break;
  }

  case ENTER_GOAL:
    if (driveTo(
          {3.6f, 1.5f},
          TRANSIT_STOP
        ) == ARRIVED &&
        turnTo(0)) {
      if (insideDestination()) {
        running = false;
        changeState(FINISHED);

        message =
          F("Nav3 destination reached; verify footprint");
      }
      else {
        fail(
          F("Goal footprint check failed")
        );
      }
    }
    break;

  default:
    break;
  }
}

void commands() {
  while (Serial.available()) {
    char command = Serial.read();

    switch (command) {
    case '1':
    case 'g':
    case 'G':
      startMission();
      break;

    case '3':
      startDestination();
      break;

    case 'm':
    case 'M':
      if (state == WAIT_MISSION &&
          pose.valid) {
        changeState(BACK_TO_GAP);

        message =
          F("Mission complete; navigating to destination");
      }
      else {
        message =
          F("m accepted only at mission wait");
      }
      break;

    case 'x':
    case 'X':
      stopMotors();

      running = false;
      autoAllowed = false;
      state = READY;

      message = F("Stopped by x");
      break;

    case 'f':
    case 'l':
    case 'r':
      if (running) {
        message =
          F("Send x before wheel test");
        break;
      }

      if (command == 'f') {
        pulseMotors(
          110,
          110,
          120
        );
      }

      if (command == 'l') {
        pulseMotors(
          -110,
          110,
          120
        );
      }

      if (command == 'r') {
        pulseMotors(
          110,
          -110,
          120
        );
      }
      break;

    case '\r':
    case '\n':
    case ' ':
      break;

    default:
      message =
        F("Commands: 1 Nav1; 3 Nav3; m done; x stop; f/l/r wheel tests");
      break;
    }
  }
}

void printStatus() {
  Serial.print(F("net="));
  Serial.print(networkState);

  Serial.print(F(" pose="));
  Serial.print(poseMessage);

  if (pose.valid) {
    Serial.print(F(" x="));
    Serial.print(pose.x, 3);

    Serial.print(F(" y="));
    Serial.print(pose.y, 3);

    Serial.print(F(" deg="));
    Serial.print(
      pose.angle * 57.29578f,
      1
    );
  }

  Serial.print(F(" zone="));
  Serial.print(startZone());

  Serial.print(F(" front="));

  if (frontValid) {
    Serial.print(
      frontRange,
      3
    );
  }
  else {
    Serial.print(F("UNKNOWN"));
  }

  Serial.print(F(" run="));
  Serial.print(running);

  Serial.print(F(" stage="));
  Serial.print(byte(state));

  Serial.print(F(" | "));
  Serial.println(message);
}

void setup() {
  pinMode(LEFT_IN1, OUTPUT);
  pinMode(LEFT_IN2, OUTPUT);
  pinMode(LEFT_ENABLE, OUTPUT);

  pinMode(RIGHT_IN1, OUTPUT);
  pinMode(RIGHT_IN2, OUTPUT);
  pinMode(RIGHT_ENABLE, OUTPUT);

  stopMotors();

  pinMode(FRONT_TRIG, OUTPUT);
  pinMode(FRONT_ECHO, INPUT);

  Serial.begin(115200);
  delay(1000);

  message =
    F("READY: 1=mission; 3=destination; m=mission done; x=STOP");

  poseMessage = F("WAITING");

  Serial.println(
    F("UNO R3 MS6 | Marker106 | MODULE TX->8 RX->9 | H-bridge pins must match")
  );

  Serial.println(
    F("Initializing Vision...")
  );

  Serial.flush();

  Enes100.begin(
    "Water We Doing",
    WATER,
    106,
    1116,
    6,
    7
  );
}

void loop() {
  stopMotors();
  commands();

  if (millis() - lastCycle < 150UL) {
    delay(1);
    return;
  }

  lastCycle = millis();

  bool valid = readPose();

  readRange();
  commands();

  if (valid && startZone() != '?') {
    if (!stableSince) {
      stableSince = millis();
    }

    if (autoAllowed &&
        state == READY &&
        millis() - stableSince >= 5000UL) {
      startMission();
    }
  }
  else {
    stableSince = 0;
  }

  // 先在停车状态下打印信息，再执行短时运动。
  if (millis() - lastPrint >= 750UL) {
    lastPrint = millis();
    printStatus();
  }

  navigation();
  stopMotors();
}
