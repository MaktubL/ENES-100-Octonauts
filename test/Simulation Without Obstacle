import math

MARKER_ID = 0

# Mission site 的真实坐标（需要修改）
MISSION_X = 2.00
MISSION_Y = 1.00

LIMBO_X = 3.15
LIMBO_Y = 1.45
ARRIVE_TOL = 0.07
TURN_TOL = 0.10
DRIVE_PWM = 145
TURN_PWM = 110

stage = 0

def wrap(angle):
    return math.atan2(math.sin(angle), math.cos(angle))

def drive_to(goal_x, goal_y):
    x = enes100.get_x()
    y = enes100.get_y()
    theta = enes100.get_theta()
    dx = goal_x - x
    dy = goal_y - y
    distance = math.sqrt(dx * dx + dy * dy)

    if distance <= ARRIVE_TOL:
        tank.turn_off_motors()
        return True
    
    desired_heading = math.atan2(dy, dx)
    heading_error = wrap(desired_heading - theta)

    if abs(heading_error) > TURN_TOL:
        if heading_error > 0:
            tank.set_left_motor_pwm(-TURN_PWM)
            tank.set_right_motor_pwm(TURN_PWM)
        else:
            tank.set_left_motor_pwm(TURN_PWM)
            tank.set_right_motor_pwm(-TURN_PWM)
    else:
        correction = int(heading_error * 220)
        left = DRIVE_PWM - correction
        right = DRIVE_PWM + correction
        tank.set_left_motor_pwm(max(-255, min(255, left)))
        tank.set_right_motor_pwm(max(-255, min(255, right)))
    return False

def setup():
    global stage
    tank.begin()
    enes100.begin("Navigation", WATER, MARKER_ID)
    stage = 0
    enes100.println("Stage 1: heading to mission site")

def loop():
    global stage
    if stage == 0:
        if drive_to(MISSION_X, MISSION_Y):
            stage = 1
            enes100.println("MISSION SITE REACHED")
            enes100.println("Stage 2: heading to limbo/log")
        return

    if stage == 1:
        if drive_to(LIMBO_X, LIMBO_Y):
            stage = 2
            tank.turn_off_motors()
            enes100.println("LIMBO APPROACH REACHED")
        return

    tank.turn_off_motors()